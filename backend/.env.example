# WakeLink Dev Backend — environment configuration
# Copy to .env — never commit .env

# Server port (default: 3001)
PORT=3001

# ── Phase 3: Wake-on-LAN ─────────────────────────────────────────────────────
# UDP broadcast address for magic packets.
# 255.255.255.255 works on most local networks.
# For directed broadcast (routed networks) use the subnet's broadcast address,
# e.g. 192.168.1.255 for a 192.168.1.0/24 network.
WOL_BROADCAST_ADDRESS=255.255.255.255

# UDP port for WoL (standard: 9, alternative: 7)
WOL_PORT=9

# How long to wait for a heartbeat after sending a wake packet (milliseconds).
# If no heartbeat arrives within this window, wakeStatus is set to FAILED.
# Default: 120000 (2 minutes)
WOL_WAKE_TIMEOUT_MS=120000

# ── Phase 5: Remote Session ───────────────────────────────────────────────────
# Session TTL in milliseconds (default: 1 hour)
SESSION_TTL_MS=3600000
