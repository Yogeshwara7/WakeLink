# WakeLink Agent configuration
# Copy to .env and fill in values — never commit .env

# Backend URL (development)
WAKELINK_BACKEND_URL=http://localhost:3001

# Heartbeat interval in milliseconds (default: 30000)
WAKELINK_HEARTBEAT_INTERVAL_MS=30000

# Pairing code expiry in milliseconds (default: 300000 = 5 minutes)
WAKELINK_PAIRING_EXPIRY_MS=300000

# Agent version — keep in sync with package.json
WAKELINK_AGENT_VERSION=0.1.0

# Storage directory for identity file (default: OS app data dir)
# WAKELINK_STORAGE_DIR=C:\Users\YourName\AppData\Local\WakeLink

# ── Phase 3: Wake-on-LAN ─────────────────────────────────────────────────────
# Set to true ONLY after confirming all of the following on this machine:
#   1. BIOS/UEFI: "Wake on LAN" / "Power On By PCIe" is ENABLED
#   2. Windows Device Manager → NIC properties → Power Management →
#      "Allow this device to wake the computer" is CHECKED
#   3. (Laptops) Machine is connected to mains power
# Leaving this false is safe — it prevents the backend from sending WoL packets
# to a machine that hasn't been configured, avoiding silent failures.
WAKELINK_WAKE_SUPPORTED=false
