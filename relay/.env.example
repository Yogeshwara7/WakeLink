# WakeLink Home Relay — configuration
# Copy to .env and fill in values — never commit .env

# Backend URL — must be reachable from this device
WAKELINK_BACKEND_URL=http://localhost:3001

# Relay identity — generated on first run, then persisted here
# Leave blank on first start; the relay will register and populate these.
WAKELINK_RELAY_ID=
WAKELINK_RELAY_TOKEN=

# Human-readable name for this relay device
WAKELINK_RELAY_NAME=Home Relay

# Relay version (keep in sync with package.json)
WAKELINK_RELAY_VERSION=0.1.0

# UDP broadcast address for Wake-on-LAN packets
WOL_BROADCAST_ADDRESS=255.255.255.255

# UDP port for WoL (standard: 9)
WOL_PORT=9

# How often to poll backend for commands (ms)
WAKELINK_POLL_INTERVAL_MS=5000

# How often to send heartbeat to backend (ms)
WAKELINK_HEARTBEAT_INTERVAL_MS=60000
